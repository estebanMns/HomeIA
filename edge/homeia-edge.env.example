# Copiar a /etc/homeia-edge.env (permisos 600). Los dos primeros valores los entrega HomeIA al enrolar el Edge.
HOMEIA_EDGE_ID=
HOMEIA_EDGE_SECRET=
HOMEIA_EDGE_TOPIC_ROOT=homeia/edge

# Broker local de la LAN (Mosquitto de compose.edge.yaml). Usuario propio del Edge: su nombre es HOMEIA_EDGE_ID.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Opcional: broker en la nube compartido con el backend (Railway/VPS) con TLS mutuo.
# Sin estas variables el backend debe llegar al broker local por VPN (WireGuard/Tailscale).
#UPLINK_MQTT_HOST=broker.midominio.com
#UPLINK_MQTT_TLS=true
#UPLINK_MQTT_PORT=8883
#UPLINK_MQTT_CA_CERT=/etc/homeia-edge/ca.crt
#UPLINK_MQTT_CLIENT_CERT=/etc/homeia-edge/edge.crt
#UPLINK_MQTT_CLIENT_KEY=/etc/homeia-edge/edge.key

# Zigbee2MQTT en el broker local
ZIGBEE_ENABLED=true
ZIGBEE_BASE_TOPIC=zigbee2mqtt

HOMEIA_EDGE_DATA_DIR=/var/lib/homeia-edge
HOMEIA_EDGE_HEARTBEAT_SECONDS=30
