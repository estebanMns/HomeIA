# Copia este archivo a .env y completa los valores. Nunca subas .env a git.

# --- Base de datos (PostgreSQL). Formato postgresql://usuario:clave@host:puerto/base
# HomeIA usa el esquema propio "homeia" dentro de esta base; no toca otros esquemas.
DATABASE_URL=postgresql://usuario:clave@host:5432/base
# Solo para docker compose (compose.yaml): contraseña del Postgres local
POSTGRES_PASSWORD=

# --- Seguridad
# Clave para firmar los JWT. Mínimo 32 caracteres. Genera una con: openssl rand -base64 48
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Orígenes del frontend separados por coma (producción: https://tu-dominio)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- MQTT (dispositivos IoT). Si MQTT_ENABLED=false, los comandos a dispositivos responden 503.
MQTT_ENABLED=false
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=homeia-backend
MQTT_TOPIC_PREFIX=homeia/devices

# --- WhatsApp Cloud API (Meta). Sin estas variables las alertas quedan como mensajes fallidos reenviables.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0

# --- Gemini (predicción de ocupación). Sin clave se usa la predicción por historial.
GEMINI_API_KEY=


GEMINI_MODEL=gemini-2.0-flash
# Cada cuántos segundos la IA recalcula encendido/apagado de cada casa
GEMINI_DECISION_INTERVAL_SECONDS=60

# --- Automatización
AUTOMATION_CYCLE_SECONDS=30
